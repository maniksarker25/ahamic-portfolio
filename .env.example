# Form delivery (contact, booking, newsletter) via https://resend.com
# Copy to .env.local and fill in. Without RESEND_API_KEY, forms show an error
# asking visitors to email you directly (nothing is silently lost).
RESEND_API_KEY=
# Inbox that receives submissions (defaults to the address in constants/site.ts)
CONTACT_TO_EMAIL=
# Sender on a domain you have verified in Resend, e.g. "Ahamic Website <hello@ahamicsolutions.com>"
CONTACT_FROM_EMAIL=
